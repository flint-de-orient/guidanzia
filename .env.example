# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# --- Frontend (Vite) ---
VITE_API_BASE_URL=

# --- Backend: Google Gemini API keys (fallback pool, rotated on quota) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# --- Backend: MongoDB (replaces users.db) ---
# Local dev via MongoDB Compass. For a VPS/global deployment, use a URI WITH
# credentials, e.g. mongodb://user:pass@host:27017/guidenzia?authSource=admin
MONGO_URI=mongodb://localhost:27017
MONGO_DB=guidenzia

# --- Backend: Gemini model tier overrides (all optional) ---
# The backend auto-selects working models per tier; set these only to override.
#   fast/lite -> non-thinking model (no hidden reasoning tokens)
#   think     -> reasoning model (e.g. a pro alias if you have quota)
# GEMINI_FAST_MODEL=
# GEMINI_LITE_MODEL=
# GEMINI_THINKING_MODEL=
